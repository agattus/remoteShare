# Signaling server (packages/server)
PORT=47831
HOST=0.0.0.0
# Set to 1 when running behind a reverse proxy (Caddy, nginx) so rate limiting sees real client IPs.
TRUST_PROXY=0
# Where device IDs are persisted (hash of each host key only; passwords are never stored).
DATA_DIR=./packages/server/data
# Directory with the built browser viewer. Defaults to packages/viewer/dist.
# VIEWER_DIR=
# How long the host has to approve a connection, in milliseconds.
CONSENT_TIMEOUT_MS=30000

# ICE servers handed to both peers. STUN is enough for most home networks.
STUN_URLS=stun:stun.l.google.com:19302
# TURN relay for strict NATs / corporate networks (see docker/docker-compose.yml).
# TURN_URL=turn:turn.example.com:3478
# TURN_USER=remotedesk
# TURN_PASS=change-me

# Desktop app default server address (packaged app, first launch)
# RD_SERVER_URL=https://remote.example.com
