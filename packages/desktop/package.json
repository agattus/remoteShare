{
  "name": "@remotedesk/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Tethera desktop app: share this computer or control another one.",
  "author": "Tethera",
  "homepage": "https://github.com/agattus/remoteShare",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.0"
  },
  "devDependencies": {
    "@remotedesk/shared": "*",
    "@types/node": "^22.10.0",
    "zod": "^3.24.0",
    "electron": "35.7.5",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0"
  },
  "build": {
    "appId": "com.tethera.desktop",
    "npmRebuild": false,
    "productName": "Tethera",
    "directories": { "output": "release" },
    "files": ["dist/**", "assets/**", "package.json"],
    "extraResources": [{ "from": "../viewer/dist", "to": "viewer" }],
    "asarUnpack": ["node_modules/@nut-tree-fork/**", "node_modules/@nut-tree-fork/libnut*/**"],
    "mac": {
      "category": "public.app-category.utilities",
      "target": ["dmg", "zip"],
      "artifactName": "Tethera-${arch}.${ext}",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Tethera shares your screen with people you approve.",
        "NSAppleEventsUsageDescription": "Tethera performs mouse and keyboard input sent by approved viewers."
      }
    },
    "icon": "assets/icon.png",
    "win": {
      "target": ["nsis"],
      "artifactName": "Tethera-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tethera"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Network",
      "executableName": "tethera",
      "maintainer": "Tethera <noreply@example.com>",
      "artifactName": "Tethera.${ext}"
    }
  }
}
